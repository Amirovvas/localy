# один общий .gitignore на весь проект (frontend + backend), вместо
# отдельных файлов в каждой папке

# зависимости
node_modules/

# сборки
frontend/.next/
frontend/out/
backend/dist/
build/

# переменные окружения — секреты не коммитим, .env.example оставляем
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# логи
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# прочее
.DS_Store
*.pem