PORT=5000
FRONTEND_URL=http://localhost:3000

# Transaction pooler (Supavisor, порт 6543) — не direct (5432): у Supabase
# direct-подключение теперь IPv6-only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

JWT_ACCESS_SECRET=replace-with-a-long-random-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-hex-string

# Supabase Storage (загрузка фото в чат). Project Settings -> API:
# Project URL и service_role key. service_role — секрет, только на сервере,
# во фронтенд и в git не попадает. Бакет создаётся автоматически при первой загрузке.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-secret-key   # sb_secret_... (или старый service_role — тогда SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_BUCKET=chat-images

# AI Summary (Gemini). Ключ: https://aistudio.google.com/apikey — только на сервере.
GEMINI_API_KEY=replace-with-gemini-api-key
# Необязательно. По умолчанию gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest
